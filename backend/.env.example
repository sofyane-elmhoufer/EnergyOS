# Copier ce fichier en backend/.env puis remplir. Ne JAMAIS committer backend/.env.

# Clé API Groq (agent IA). Obligatoire pour l'agent ; le reste du site fonctionne sans.
GROQ_API_KEY=

# Modèles (facultatif)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Sécurité (valeurs par défaut indiquées)
# ENSA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ENSA_ALLOWED_HOSTS=localhost,127.0.0.1
# ENSA_ENABLE_DOCS=false
# ENSA_AGENT_RATE_PER_MINUTE=10
# ENSA_API_RATE_PER_MINUTE=240
# ENSA_MAX_BODY_MB=10
# ENSA_DEMO_MODE=true

# Envoi du devis par e-mail (Espace Client). Laisser SMTP_HOST vide pour désactiver.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USER=adresse@gmail.com, SMTP_PASSWORD=<mot de passe d'application Google, 16 lettres>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ENSA_EMAIL_RATE_PER_MINUTE=3
